{
	"name": "pi-harness",
	"private": true,
	"type": "module",
	"imports": {
		"#src/*": "./src/*",
		"#tools/*": "./tools/*"
	},
	"scripts": {
		"prepare": "effect-tsgo patch --oxlint",
		"fmt": "oxfmt",
		"lint": "oxlint src tools agent/extensions agent/bin",
		"typecheck": "tsc -p .",
		"test": "bun test --parallel",
		"prompts": "bun tools/prompts/index.ts",
		"check": "oxfmt --check && bun run --parallel lint typecheck boundaries sg knip test",
		"boundaries": "depcruise src tools agent/extensions agent/bin --output-type err",
		"sg": "bun tools/gates/budget.ts",
		"knip": "knip --no-progress"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.2",
		"defuddle": "0.19.6",
		"effect": "4.1.2",
		"fast-sha256": "1.3.0",
		"linkedom": "0.18.15",
		"unpdf": "2.1.0"
	},
	"devDependencies": {
		"@ast-grep/cli": "0.51.3",
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@effect/tsgo": "0.67.5",
		"@oxlint/plugins": "1.92.0",
		"@swc/core": "1.16.22",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"dependency-cruiser": "18.8.0",
		"knip": "6.45.1",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"oxlint-tsgolint": "7.0.2006",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	},
	"trustedDependencies": [
		"@ast-grep/cli",
		"@swc/core"
	]
}
