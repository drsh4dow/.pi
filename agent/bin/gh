#!/bin/sh
# It looks gh up as the shell does (no globbing, an empty entry is the current folder, only regular files), minus itself.
# Every merge shape the gate reads has "merge" in an argument, so only those calls pay for starting it.
self=$(readlink -f "$0")
path="$PATH:"
set -f
IFS=:
for dir in $path; do
	candidate=${dir:-.}/gh
	if [ -f "$candidate" ] && [ -x "$candidate" ] && [ "$(readlink -f "$candidate")" != "$self" ]; then
		case "$*" in
		*[Mm][Ee][Rr][Gg][Ee]*) exec bun "${self%/*}/merge-gate.ts" "$candidate" "$@" ;;
		esac
		exec "$candidate" "$@"
	fi
done
echo "gh: no gh on PATH but $self" >&2
exit 127
