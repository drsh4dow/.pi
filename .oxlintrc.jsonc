{
	"$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
	"extends": ["./oxlint-effect.json"],
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "jsdoc"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "error",
		"perf": "error",
		"style": "error",
		"restriction": "error",
	},
	"options": {
		"typeAware": true,
		"typeCheck": true,
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "error",
	},
	"ignorePatterns": [
		".agent/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".continue/**",
		".cursor/**",
		".gemini/**",
		".opencode/**",
		".pi/**",
		".roo/**",
		".windsurf/**",
		"tools/oxlint/anti-slop/**",
		"tools/gates/fixtures/**",
	],
	"jsPlugins": [
		{
			"name": "anti-slop",
			"specifier": "./tools/oxlint/anti-slop/index.ts",
		},
		{
			"name": "anti-slop-effect",
			"specifier": "./tools/oxlint/anti-slop/effect/index.ts",
		},
	],
	"rules": {
		"oxc/no-accumulating-spread": "error",
		"anti-slop/no-array-filter-map": "error",
		"anti-slop/no-reduce-accumulator-copy": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-readable-spacing": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"anti-slop-effect/no-manual-effect-error-tag": "error",
		"anti-slop-effect/no-manual-tag-comparison": "error",
		"anti-slop-effect/no-manual-tagged-construction": "error",
		"anti-slop-effect/no-service-constructor-imports": "error",
		"anti-slop-effect/prefer-effect-match": "error",
		// Bans: each names the one owner allowed to use the API, which the overrides below exempt
		"eslint/no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "effect/FileSystem",
						"message": "Read and write disk through the src/client/ folder that owns the file, such as #src/client/web-cache/index.ts. Add a client for a new store.",
					},
					{
						"name": "node:fs",
						"message": "Read and write disk through the src/client/ folder that owns the file, such as #src/client/web-cache/index.ts. Add a client for a new store.",
					},
					{
						"name": "node:fs/promises",
						"message": "Read and write disk through the src/client/ folder that owns the file, such as #src/client/web-cache/index.ts. Add a client for a new store.",
					},
					{
						"name": "node:child_process",
						"message": "Run outside commands through the src/client/ folder for that system, such as #src/client/gh/index.ts. Add a client for a new one.",
					},
					{
						"name": "@effect/platform-node/NodeHttpClient",
						"message": "Call the src/client/ folder for that service, such as #src/client/exa/index.ts. Add a client for a new one.",
					},
				],
				"patterns": [
					{
						"group": ["effect/http/*"],
						"message": "Call the src/client/ folder for that service, such as #src/client/exa/index.ts. Add a client for a new one.",
					},
					{
						"group": ["effect/process/*"],
						"message": "Run outside commands through the src/client/ folder for that system, such as #src/client/gh/index.ts. Add a client for a new one.",
					},
				],
			},
		],
		"eslint/no-restricted-properties": [
			"error",
			{
				"property": "runPromise",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runPromiseExit",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runPromiseWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runPromiseExitWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runFork",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runForkWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runSync",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runSyncExit",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runSyncWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runSyncExitWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runCallback",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"property": "runCallbackWith",
				"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
			},
			{
				"object": "Bun",
				"property": "env",
				"message": "Read the environment in the entry file and pass it in, or read one variable with Effect's Config.",
			},
			{
				"object": "Bun",
				"property": "file",
				"message": "Read and write disk through the src/client/ folder that owns the file, such as #src/client/web-cache/index.ts. Add a client for a new store.",
			},
			{
				"object": "Bun",
				"property": "write",
				"message": "Read and write disk through the src/client/ folder that owns the file, such as #src/client/web-cache/index.ts. Add a client for a new store.",
			},
			{
				"object": "Bun",
				"property": "spawn",
				"message": "Run outside commands through the src/client/ folder for that system, such as #src/client/gh/index.ts. Add a client for a new one.",
			},
			{
				"object": "Bun",
				"property": "spawnSync",
				"message": "Run outside commands through the src/client/ folder for that system, such as #src/client/gh/index.ts. Add a client for a new one.",
			},
			{
				"object": "Bun",
				"property": "$",
				"message": "Run outside commands through the src/client/ folder for that system, such as #src/client/gh/index.ts. Add a client for a new one.",
			},
		],
		// Effect's own setting; pi writes `string[]`, Effect wins
		"typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
		// pi tool handlers take (toolCallId, params, signal, onUpdate, ctx)
		"eslint/max-params": ["error", { "max": 5 }],
		// Effect constructors are capitalized calls, e.g. Schema.Struct(...)
		"eslint/new-cap": ["error", { "capIsNew": false }],
		"eslint/one-var": ["error", "never"],
		// Effect declares tagged errors and services as classes, several per module
		"eslint/max-classes-per-file": "off",
		// oxfmt sorts imports, as Biome does for pi
		"eslint/sort-imports": "off",
		// misreads Schema.TaggedError<...>()(...) as an error thrown without new
		"unicorn/throw-new-error": "off",
		// Effect and pi use plain ternaries
		"eslint/no-ternary": "off",
		// Effect APIs take inline literals, e.g. Schedule.recurs(3)
		"eslint/no-magic-numbers": "off",
		// Effect.gen(function* () {}) is anonymous by convention
		"eslint/func-names": "off",
		// misreads Effect combinator callbacks such as catchTag handlers
		"promise/prefer-await-to-callbacks": "off",
		// Effect and pi order keys by meaning, e.g. a pi tool's name, label, description
		"eslint/sort-keys": "off",
		// pi's ExtensionAPI and Effect callback parameter types are not deeply readonly
		"typescript/prefer-readonly-parameter-types": "off",
		// tsconfig's namespaceImportPackages, copied from Effect's own config, makes effecttsgo/prefer-namespace-import require `import * as`
		"import/no-namespace": "off",
		// Effect's namespace imports give each module its own import line, so a feature passes ten at once
		"import/max-dependencies": "off",
		// Effect code exports each value by name, inline
		"import/no-named-export": "off",
		"import/group-exports": "off",
		"import/exports-last": "off",
		"import/prefer-default-export": "off",
		// pi and Effect write `import { type X, y }`; with no-duplicate-imports, no other form passes
		"import/consistent-type-specifier-style": "off",
		// `_tag` is Effect's discriminant
		"eslint/no-underscore-dangle": "off",
		// Effect pairs a schema value with its type, `const Turn` and `type Turn`
		"eslint/no-redeclare": "off",
		// misread Effect's Array module functions as native array methods
		"unicorn/no-array-callback-reference": "off",
		"unicorn/no-array-method-this-argument": "off",
		// misreads Effect.forEach as Array.prototype.forEach
		"unicorn/no-array-for-each": "off",
		// The user chose Effect platform modules, which Effect marks unstable (tsconfig allowedUnstableApis lists them), and this rule guards a published package's API, which the harness has none of
		"effecttsgo/api-stability-leak": "off",
		// collides with effecttsgo/async-function, oxc/no-async-await and eslint/require-await: a function that returns a promise fails it without async and the others with it
		"typescript/promise-function-async": "off",
		// collides with eslint/prefer-object-spread: an object spread fails it, and Object.assign fails the other
		"oxc/no-rest-spread-properties": "off",
		// collides with oxfmt, which lowercases a hex literal's digits
		"unicorn/number-literal-case": "off",
	},
	"overrides": [
		{
			"files": ["**/*.test.ts"],
			"plugins": ["jest"],
		},
		{
			// src/client/ owns disk, HTTP and processes
			"files": ["src/client/**"],
			"rules": {
				"eslint/no-restricted-imports": "off",
				"eslint/no-restricted-properties": [
					"error",
					{
						"property": "runPromise",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runPromiseExit",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runPromiseWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runPromiseExitWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runFork",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runForkWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runSync",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runSyncExit",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runSyncWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runSyncExitWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runCallback",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
					{
						"property": "runCallbackWith",
						"message": "Return the Effect and hand it to run or fork from #src/client/pi-host/index.ts, the one place that runs Effects.",
					},
				],
			},
		},
		{
			// pi-host owns the Effect runners
			"files": ["src/client/pi-host/**"],
			"rules": {
				"eslint/no-restricted-imports": "off",
				"eslint/no-restricted-properties": "off",
			},
		},
		{
			// entry files own process.env and hand what a feature needs to it
			"files": ["agent/extensions/*/index.ts", "agent/bin/*.ts"],
			"rules": {
				"node/no-process-env": "off",
			},
		},
		{
			// tools/ and the PHI eval corpus are outside the runtime the bans guard
			"files": ["tools/**", "src/features/phi-router/corpus/**"],
			"rules": {
				"eslint/no-restricted-imports": "off",
				"eslint/no-restricted-properties": [
					"error",
					{
						"object": "Bun",
						"property": "env",
						"message": "Read the environment in the entry file and pass it in, or read one variable with Effect's Config.",
					},
				],
			},
		},
		{
			// test code sets up files and processes itself, and waits on conditions
			"files": ["**/*.test.ts", "**/*.fixture.ts", "**/*.scenario.ts"],
			"rules": {
				"eslint/no-restricted-imports": "off",
				"eslint/no-restricted-properties": [
					"error",
					{
						"object": "Effect",
						"property": "sleep",
						"message": "Wait on a condition, never a fixed time: call eventually from #src/primitives/eventually.ts.",
					},
					{
						"object": "Bun",
						"property": "sleep",
						"message": "Wait on a condition, never a fixed time: call eventually from #src/primitives/eventually.ts.",
					},
				],
			},
		},
		{
			// pi and oxlint load these files' default export, so no other export form works
			"files": [
				"agent/extensions/*/index.ts",
				"src/features/phi-router/border.fixture.ts",
				"tools/driver/probe.ts",
				"tools/prompts/capture.ts",
				"tools/oxlint/fixtures/effect-pi-idioms.ts",
			],
			"rules": {
				"import/no-default-export": "off",
			},
		},
		{
			// The URL guard pins the address it checked by replacing node:http's DNS lookup, which only node:dns and node:net offer
			"files": ["src/client/web/guard.ts"],
			"rules": {
				"import/no-nodejs-modules": ["error", { "allow": ["node:dns", "node:net"] }],
			},
		},
	],
}
